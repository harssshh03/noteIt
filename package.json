{
  "name": "noteit",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @noteit/api db:migrate",
    "deploy:api": "pnpm --filter @noteit/api deploy"
  },
  "devDependencies": { "turbo": "^2.5.0" }
}
